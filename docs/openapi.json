  "components": {
    "schemas": {
      "SsoEnabled": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Policy": {
        "type": "object",
        "properties": {
          "ssoOnly": {
            "type": "boolean"
          },
          "mfaMode": {
            "type": "string",
            "pattern": "OPTIONAL|MANDATORY|TRUSTED_EXTERNAL"
          },
          "jitEnabled": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "mfaMode"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "pattern": "ADMIN|MEMBER"
          },
          "status": {
            "type": "string",
            "pattern": "ACTIVE|REVOKED"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "role",
          "status"
        ]
      },
      "CreateOrganization": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 0
          },
          "slug": {
            "type": "string",
            "pattern": "[a-z0-9][a-z0-9-]{2,62}"
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "Invite": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "role": {
            "type": "string",
            "pattern": "ADMIN|MEMBER"
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "Accept": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "[A-Za-z0-9_-]{43}"
          }
        }
      },
      "Discovery": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "maxLength": 254,
            "minLength": 0
          }
        },
        "required": [
          "identifier"
        ]
      },
      "CsrfToken": {
        "type": "object",
        "properties": {
          "headerName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "parameterName": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "name": "PLATFORM_SESSION",
        "in": "cookie"
      },
      "csrf": {
        "type": "apiKey",
        "name": "X-CSRF-TOKEN",
        "in": "header"
      }
    }
  }
}
